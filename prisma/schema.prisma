
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  user
  delivery
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  firstName            String    @db.VarChar(50)
  lastName             String    @db.VarChar(50)
  email                String    @unique @db.VarChar(255)
  password             String    @db.VarChar(255)
  phonePrimary         String    @map("phone_primary") @db.VarChar(20) @unique
  phoneSecondary       String?   @map("phone_secondary") @db.VarChar(20) @unique
  address              String?   @db.Text
  avatarUrl            String?   @map("avatar_url") @db.Text
  avatarPublicId       String?   @map("avatar_public_id") @db.Text
  role                 UserRole  @default(user)
  isVerified           Boolean   @default(false) @map("is_verified")
  resetPasswordToken   String?   @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires DateTime? @map("reset_password_expires") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  verificationCodes VerificationCode[]

  @@map("users")
}

model VerificationCode {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  code       String   @db.VarChar(6)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz()
  lastSentAt DateTime @default(now()) @map("last_sent_at") @db.Timestamptz()
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_codes")
}

// ─── أضف ده لـ schema.prisma الموجود ───────────────────────────────────────────

enum MenuCategory {
  appetizer
  main_course 
  dessert 
  beverage  
  side_dish   
}

model MenuItem {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(100)
  description String?         @db.Text
  price       Decimal         @db.Decimal(10, 2)
  category    MenuCategory
  isAvailable Boolean         @default(true) @map("is_available")
  hasDiscount Boolean         @default(false) @map("has_discount")
  discountPercentage Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  rating      Decimal         @default(0) @db.Decimal(2, 1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  images      MenuItemImage[]

  @@map("menu_items")
}

model MenuItemImage {
  id          String   @id @default(uuid()) @db.Uuid
  menuItemId  String   @map("menu_item_id") @db.Uuid
  url         String   @db.Text
  publicId    String   @map("public_id") @db.Text
  order       Int      @default(0)          
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_images")
}
